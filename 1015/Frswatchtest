# 1) 지금 어떤 스크립트가 돌고 있는지 확인
Get-CimInstance Win32_Process -Filter "Name='powershell.exe'" | ? CommandLine -match 'FRS-Network-Watch' | Select ProcessId,CommandLine

# 2) 디스크의 파일이 수정본인지 확인 (결과가 나오면 수정본)
Select-String C:\Scripts\FRS-Network-Watch.ps1 -Pattern 'New-WslStartInfo' | Select -First 1

# 3) 실행 중인 감시 스크립트를 모두 종료
Get-CimInstance Win32_Process -Filter "Name='powershell.exe'" | ? CommandLine -match 'FRS-Network-Watch' | % { Stop-Process -Id $_.ProcessId -Force }

# 4) 방금 보낸 v3.1로 파일 교체 후, 작업 다시 시작
Start-ScheduledTask -TaskName 'FRS-Network-Watch'

# 5) 로그 확인
Get-Content C:\ProgramData\FRSNetworkWatch\watch.log -Tail 10 -Wait
